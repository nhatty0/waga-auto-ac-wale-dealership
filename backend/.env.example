DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/elite_motors_db
PORT=8000
TELEGRAM_PLATFORM_BOT_TOKEN=your_platform_bot_token
TELEGRAM_PLATFORM_BOT_USERNAME=WagaDealershipBot
TELEGRAM_BOT_TOKEN=your_platform_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_BOT_USERNAME=WagaDealershipBot
SUPERADMIN_PHONE=251918032065
JWT_SECRET_KEY=your_secret_jwt_key

# AfroMessage SMS Gateway Configuration
AFROMESSAGE_API_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER_NAME=
ENABLE_SMS_DISPATCH=true

# Public Base URL for local static storage (defaults to /static/uploads)
LOCAL_BASE_URL=/static/uploads


# Optional: Cloudflare R2 / AWS S3 Cloud Storage Configuration
# If USE_S3_STORAGE is false or omitted, images are automatically saved to backend/uploads/ in optimized .webp format.
USE_S3_STORAGE=false
S3_BUCKET_NAME=your-bucket-name
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=your_r2_or_s3_access_key
S3_SECRET_KEY=your_r2_or_s3_secret_key
S3_PUBLIC_CUSTOM_DOMAIN=https://cdn.yourdomain.com
