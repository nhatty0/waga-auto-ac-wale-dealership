SINGLE_TENANT_MODE=true
PLATFORM_NAME="AC WALE MARKET"
PRIMARY_DEALERSHIP_SLUG=ac-wale-cars
PRIMARY_DEALERSHIP_NAME="AC WALE MARKET"
PRIMARY_DEALERSHIP_PHONE="+251983112211"
PRIMARY_DEALERSHIP_PHONE_2="+251989113211"
# Owner phones (comma-separated). Only these numbers get superadmin access.
SUPERADMIN_PHONE="251900061300,251918032065"
DATABASE_URL="sqlite:///./ac_wale_cars.db"
PORT=8000
JWT_SECRET_KEY=your_production_secret_jwt_key_here

# Telegram Bot (Optional - can also be configured directly in /admin Settings tab)
TELEGRAM_PLATFORM_BOT_TOKEN=""
TELEGRAM_PLATFORM_BOT_USERNAME=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_BOT_USERNAME=""
# Webhook (Settings -> Telegram status -> Set webhook). Secret: letters, digits, _ and - only.
TELEGRAM_WEBHOOK_SECRET=""
# Public API base; the webhook is PUBLIC_API_URL + /api/telegram/webhook (or set TELEGRAM_WEBHOOK_URL).
PUBLIC_API_URL="https://api.acwalecarmarket.com/v1"
TELEGRAM_WEBHOOK_URL=""

# AfroMessage SMS Gateway Configuration
AFROMESSAGE_API_TOKEN=""
AFROMESSAGE_IDENTIFIER_ID=""
AFROMESSAGE_SENDER_NAME="WagaExpress"
ENABLE_SMS_DISPATCH=true

# Public Base URL for local static storage (defaults to /static/uploads)
LOCAL_BASE_URL=/static/uploads

# Optional: Cloudflare R2 / AWS S3 Cloud Storage Configuration
USE_S3_STORAGE=false
S3_BUCKET_NAME=your-bucket-name
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=your_r2_or_s3_access_key
S3_SECRET_KEY=your_r2_or_s3_secret_key
S3_PUBLIC_CUSTOM_DOMAIN=https://cdn.yourdomain.com
