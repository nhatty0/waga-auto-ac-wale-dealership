# Copy to backend/.env on the Yegara server (File Manager), then fill in the values.
# Replace CPANELUSER with your cPanel username and acwale.et with your real domain.

SINGLE_TENANT_MODE=true
PLATFORM_NAME="AC WALE MARKET"
PRIMARY_DEALERSHIP_SLUG=ac-wale-cars
PRIMARY_DEALERSHIP_NAME="AC WALE MARKET"
PRIMARY_DEALERSHIP_PHONE="+251911646628"
PRIMARY_DEALERSHIP_PHONE_2="+251900061300"
SUPERADMIN_PHONE=251911646628

# Database and media live OUTSIDE the code folder so Git updates never touch them.
# Note the FOUR slashes after "sqlite:" (absolute path).
DATABASE_URL=sqlite:////home/CPANELUSER/acwale_data/ac_wale_cars.db
STATIC_ROOT=/home/CPANELUSER/acwale_data/static
LOCAL_BASE_URL=/static/uploads

# REQUIRED. Generate a random value (e.g. in cPanel Terminal: python3 -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET_KEY=

CORS_ORIGINS=https://acwale.et,https://www.acwale.et

# Telegram (use a NEW token from @BotFather - the old one was published in handoff.md)
TELEGRAM_PLATFORM_BOT_TOKEN=
TELEGRAM_PLATFORM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
# Any random string; pass the same value as secret_token when calling setWebhook
TELEGRAM_WEBHOOK_SECRET=

# AfroMessage SMS
AFROMESSAGE_API_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER_NAME="WagaExpress"
ENABLE_SMS_DISPATCH=true

USE_S3_STORAGE=false
